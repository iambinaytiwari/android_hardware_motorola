cc_library_static {
    name: "android.hardware.biometrics.fingerprint-service.motorola.lib",
    vendor_available: true,
    local_include_dirs: ["include"],
    srcs: [
        "LockoutTracker.cpp",
        "FingerprintEngine.cpp",
        "FingerprintEngineUdfps.cpp",
        "Fingerprint.cpp",
        "Session.cpp",
        "FingerprintConfig.cpp",
        "main.cpp",
    ],
    stl: "c++_static",
    shared_libs: [
        "libbinder_ndk",
        "libhardware",
        "liblog",
    ],
    whole_static_libs: [
        "libandroid.hardware.biometrics.fingerprint.MotorolaProps",
        "libbase",
        "android.hardware.biometrics.fingerprint-V4-ndk",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.common.thread",
        "android.hardware.biometrics.common.util",
        "android.hardware.biometrics.common.config",
        "android.hardware.keymaster-V4-ndk",
    ],
}

cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.motorola",
    //system_ext_specific: true,
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["fingerprint-motorola.rc"],
    vintf_fragment_modules: ["android.hardware.biometrics.fingerprint-service.motorola.vintf"],
    local_include_dirs: ["include"],
    srcs: [
    ],
    stl: "c++_static",
    shared_libs: [
        "libbinder_ndk",
        "liblog",
    ],
    whole_static_libs: [
        "android.hardware.biometrics.fingerprint-service.motorola.lib",
    ],
}

vintf_fragment {
    name: "android.hardware.biometrics.fingerprint-service.motorola.vintf",
    src: "fingerprint-motorola.xml",
    vendor: true,
}

sysprop_library {
    name: "android.hardware.biometrics.fingerprint.MotorolaProps",
    srcs: ["fingerprint.sysprop"],
    property_owner: "Vendor",
    vendor: true,
}
